# iOS 依赖管理(CocoaPods): 所有 Flutter 插件的原生代码都靠这个文件装进 Xcode 工程
# * 之前工程里没有 Podfile -> pod install 没跑过 -> 带插件的 iOS 包根本编不过
# * 部署目标与 Xcode 工程保持一致(Runner -> Deployment Target = 15.0)
# * 注意: 不能低于 15.0 —— Codemagic 上的 Flutter stable 要求更高的 min deployment target,
#   13.0 时 pod install 报 "could not find compatible versions for pod Flutter ...
#   required a higher minimum deployment target"
source 'https://mirrors.tuna.tsinghua.edu.cn/git/CocoaPods/Specs.git'
source 'https://github.com/volcengine/volcengine-specs.git'
source 'https://github.com/aliyun/aliyun-specs.git'

platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # 必须静态链接: 穿山甲/火山引擎 SDK(RangersAPM / RangersAppLog / OneKit / TTSDKFramework)
  # 是静态二进制, 动态链接下 pod install 直接失败:
  # "target has transitive dependencies that include statically linked binaries"
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # 穿山甲内容SDK(短剧)必须依赖带-premium的点播引擎, 否则 start 阶段报
  # "未依赖TTSDKFramework的premium版本" START_FAILED(error_code=6), 短剧走兜底。
  # 插件 podspec 里这条依赖被注释掉了, 必须在工程 Podfile 显式声明;
  # 版本与 pangrowth_content 插件注释保持一致。
  pod 'TTSDKFramework/Player-SR', '1.42.3.4-premium'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # 直播连麦(TRTC)用到的权限: permission_handler 只编译"被打开"的权限,
    # 不加这两个宏, iOS 上申请相机 / 麦克风会直接报权限未注册(Podfile 是唯一配置入口)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_WARN_ABOUT_PARENTHESES'] = 'NO'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',
        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end

  # ---------------------------------------------------------------------------
  # YYText 1.0.7 的定位缺陷: 源码里写成了 `a < b < c` 这种链式比较,
  # 在 C/ObjC 里等价于 `(a < b) < c`, 结果恒为 0/1 并被直接赋给 position,
  # 于是 YYLabel / YYTextView 的点击定位永远落在第 0/1 个字符 -> 文字点选错位。
  # pod install 每次都会重新解包覆盖该文件, 所以在这里幂等地重打补丁。
  # ---------------------------------------------------------------------------
  yylayout_path = File.join(installer.sandbox.root.to_s, 'YYText/YYText/Component/YYTextLayout.m')
  if File.exist?(yylayout_path)
    yylayout_src = File.read(yylayout_path)
    yylayout_fixed = yylayout_src
      .gsub('position = fabs(left - point.y) < fabs(right - point.y) < (right ? prev : next);',
            'position = (fabs(left - point.y) < fabs(right - point.y)) ? (right ? prev : next) : position;')
      .gsub('position = fabs(left - point.x) < fabs(right - point.x) < (right ? prev : next);',
            'position = (fabs(left - point.x) < fabs(right - point.x)) ? (right ? prev : next) : position;')
    if yylayout_fixed != yylayout_src
      File.chmod(0644, yylayout_path) rescue nil
      File.write(yylayout_path, yylayout_fixed)
      puts '[Podfile] YYTextLayout.m 链式比较缺陷已修复'
    end
  end
end
